# Copy to .env.local (gitignored) to change either of these. Both have working defaults, so the
# dashboard runs against a locally started platform with no configuration at all.

# Where the dashboard API is. The default is the host port this project reserves for it; a
# deployment sets this to a real origin. Whatever is set here must also appear in the API's
# fleet.dashboard.cors-origins list, or the browser will refuse a response the server sent
# perfectly happily -- the request succeeds in the server log and never reaches the page.
VITE_API_BASE=http://localhost:18083

# Replaces the built-in OpenStreetMap raster basemap with a style URL. OpenStreetMap asks that its
# own tile servers not be used for heavy traffic, so the public build (scripts/public-publish.sh)
# sets this to OpenFreeMap's vector style: no key, no signup, attribution added by MapLibre.
# VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# The public build. No live stream; the API is a Lambda answering from the S3 archive, on the same
# origin as the page (so VITE_API_BASE is set to empty). Set only by scripts/public-publish.sh.
# VITE_ARCHIVE_MODE=true
