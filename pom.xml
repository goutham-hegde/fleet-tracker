<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.fleettracking</groupId>
  <artifactId>fleet-tracking-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>fleet-tracking</name>
  <description>Real-time shipment and fleet tracking platform</description>

  <modules>
    <module>libs/events</module>
    <module>libs/reference</module>
    <module>services/ingest-gateway</module>
    <module>services/tracking-processor</module>
    <module>services/shipment-service</module>
    <module>services/exception-service</module>
    <module>services/dashboard-api</module>
    <module>tools/fleet-simulator</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spring-boot.version>4.1.1</spring-boot.version>

    <!-- Container images. Jib builds them from the compiled classes without a Dockerfile and
         without a Docker daemon of its own : see the pluginManagement entry below for why that
         matters here. -->
    <jib-maven-plugin.version>3.5.2</jib-maven-plugin.version>

    <!-- Where images are named. The repository is public, so ghcr.io is free and unlimited for
         it; ECR's free tier is 500 MB for twelve months and would not hold these. M7 pushes
         here from CI. Locally the same name is built straight into the Docker daemon and loaded
         into Kind, so an image never has to travel over the network to be run. -->
    <image.repository>ghcr.io/goutham-hegde/fleet-tracker</image.repository>

    <!-- The tag every manifest in deploy/ refers to. A moving tag like "latest" is exactly the
         wrong thing for a cluster to pull : two nodes can disagree about what it means, and a
         rollback has nothing to roll back to. M7 replaces this with the commit SHA. -->
    <image.tag>${project.version}</image.tag>

    <!-- The commit an image was built from, stamped into it as an OCI label. Empty by default and
         overridden by CI with the SHA. It reads `local` off CI rather than being left empty, for
         two reasons: a laptop build genuinely has no commit to claim, because the working tree it
         built from may never be committed; and an empty XML element reaches a plugin as a null
         rather than as an empty string, which is the sort of thing that fails inside a plugin
         rather than in the build it configures. -->
    <image.revision>local</image.revision>

    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot BOM imported rather than inherited: libs/events is a plain
           library and should not pick up the Spring Boot parent's plugin config. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <!-- Keep parameter names in the bytecode. Spring resolves @PathVariable and
                 @RequestParam by parameter name unless one is stated in the annotation, and
                 javac discards those names without this flag: the endpoint then fails at
                 request time, not at compile time, with "Name for argument of type
                 [java.lang.String] not specified". spring-boot-starter-parent sets this,
                 and this build imports the BOM instead : same shape of gap as the
                 repackage goal each service has to declare for itself. -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>

        <!-- Every service image is built by this one configuration; a service module declares the
             plugin and states nothing, so five images cannot drift apart in their base layer,
             their JVM flags or their user.

             Jib rather than a Dockerfile per service. Three reasons, in order of how much they
             matter here. It needs no Docker daemon to build an image, which is what makes M7's CI
             job a plain Maven run rather than a privileged one. It layers by rate of change :
             dependencies, resources, then this project's own classes, so a code change repushes a
             few hundred kilobytes instead of a fat jar. And there is no Dockerfile to keep in step
             with the build : the classpath and the main class come from the POM that already
             states them. The cost is that the image is not a "java -jar app.jar" image; Jib puts
             the classpath on disk and runs the main class directly, so the Spring Boot executable
             jar built by the repackage goal is not what ships. Both are still produced. -->
        <plugin>
          <groupId>com.google.cloud.tools</groupId>
          <artifactId>jib-maven-plugin</artifactId>
          <version>${jib-maven-plugin.version}</version>
          <configuration>
            <from>
              <!-- A JRE, not a JDK : half the size, and no compiler in a runtime image. Alpine
                   rather than the Ubuntu-based default for the same reason, and it is worth about
                   300 MB per image; the five services share the layer, so the saving lands once on
                   a laptop and five times in a registry.

                   Temurin rather than distroless, deliberately. Distroless has no shell, so
                   `kubectl exec` into a misbehaving pod gives nothing at all : and M6 is precisely
                   the milestone where pods are expected to misbehave. -->
              <image>eclipse-temurin:21-jre-alpine</image>
            </from>
            <to>
              <!-- Tag stated here rather than in a <tags> list, which would ALSO produce a
                   `latest` : the tag on to.image defaults to latest when none is given. A moving
                   tag is the wrong thing for a cluster to hold: two nodes can disagree about what
                   it means and a rollback has nothing to roll back to. -->
              <image>${image.repository}/${project.artifactId}:${image.tag}</image>
            </to>
            <container>
              <!-- The JVM sizes the heap from the *container* limit, not the host, as long as it
                   is told what share to take. 75% of 512Mi leaves room for the JVM's own
                   non-heap memory : metaspace, thread stacks, the Kafka client's direct buffers.
                   Without it the default is 25%, which wastes most of the limit the manifests
                   ask for. -->
              <jvmFlags>
                <jvmFlag>-XX:MaxRAMPercentage=75</jvmFlag>
                <!-- Container-friendly randomness. /dev/random blocks on a machine with little
                     entropy, which on a fresh node shows up as a service that hangs during
                     startup with nothing in the log after the banner. -->
                <jvmFlag>-Djava.security.egd=file:/dev/./urandom</jvmFlag>
              </jvmFlags>
              <!-- Not root. Jib's default is uid 0 unless told otherwise, and a JVM serving
                   HTTP has no need of it. -->
              <user>1000:1000</user>
              <!-- A fixed creation time is what makes the same source produce the same image
                   digest. The alternative, USE_CURRENT_TIMESTAMP, is honest about when an image
                   was built and gives up reproducibility for it; reproducibility is the more
                   useful property once CI is tagging images by commit, because two builds of one
                   commit then produce the same digest and a deployment can be compared against
                   what is running. The cost is cosmetic: `docker images` reports every image as
                   55 years old, because the fixed instant is the Unix epoch. -->
              <creationTime>EPOCH</creationTime>
              <!-- Open Container Initiative annotations. `image.source` is the one that does real
                   work: ghcr.io reads it and links the published package to this repository, which
                   is what gives the package a README, an owner and the repository's own visibility
                   rules. Without it a package arrives at ghcr.io orphaned, and the only way to say
                   which commit produced it is to remember. `image.revision` is the commit, passed
                   in by CI; locally it is empty, which is honest : a laptop build has no commit
                   behind it because the working tree may not be committed at all. -->
              <labels>
                <org.opencontainers.image.source>https://github.com/goutham-hegde/fleet-tracker</org.opencontainers.image.source>
                <org.opencontainers.image.title>${project.artifactId}</org.opencontainers.image.title>
                <org.opencontainers.image.revision>${image.revision}</org.opencontainers.image.revision>
              </labels>
            </container>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Unit tests: *Test.java. Fast, no containers. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>

      <!-- Integration tests: *IT.java. Testcontainers-backed, bound to verify. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven-failsafe-plugin.version}</version>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <!-- Failsafe tests the packaged artifact by design, which breaks against a Spring Boot
               service: the repackage goal rewrites the module's jar into an executable one whose
               classes live under BOOT-INF/classes, so nothing on the test classpath can see them.
               The symptom names none of that: the context simply fails with "Unable to find a
               @SpringBootConfiguration by searching packages upwards from the test", as though the
               application class had been misplaced. Pointing Failsafe at the plain output directory
               tests exactly what Surefire does. -->
          <classesDirectory>${project.build.outputDirectory}</classesDirectory>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Container images: ./mvnw -Pimages -DskipTests package
         (or scripts/images.sh, which also loads them into Kind).

         A profile rather than a normal execution, because building six images is slow and nothing
         about `./mvnw verify` needs one. And a bound execution rather than `./mvnw jib:dockerBuild`
         on the command line, because a goal invoked that way runs against every module in the
         reactor, including libs/events, which has no main class and fails with a message about
         adding one. Binding it here means only the modules that declared the plugin build an
         image, and the two libraries are silently and correctly skipped.

         dockerBuild puts the image straight into the local Docker daemon, from where scripts/
         images.sh loads it into the Kind node. M7's CI job will use the `build` goal instead,
         which pushes to a registry and needs no Docker daemon at all. -->
    <profile>
      <id>images</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>com.google.cloud.tools</groupId>
              <artifactId>jib-maven-plugin</artifactId>
              <executions>
                <execution>
                  <id>build-image</id>
                  <phase>package</phase>
                  <goals>
                    <goal>dockerBuild</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>

    <!-- Container images, pushed to a registry: ./mvnw -Ppublish -DskipTests package
         -Dimage.tag=<sha>. This is what CI runs on a merge to main and it is the only difference
         between a laptop build and a published one : the same POM, the same base image, the same
         JVM flags, one different goal.

         `build` rather than `dockerBuild`. dockerBuild hands the finished image to a local Docker
         daemon; build assembles the layers and pushes them straight to the registry over HTTPS,
         with no daemon involved anywhere. That is why the images job in CI is an ordinary Maven
         run rather than a privileged one, and it is most of the reason this project uses Jib at
         all : a Dockerfile per service would need a daemon, a build context and a Docker login
         inside the job for each of them.

         Credentials are not stated here and must not be. Jib reads the same ~/.docker/config.json
         that `docker login` writes, so CI logs in once with the token GitHub hands the job and Jib
         finds it. A username and password in this file would be a secret in a public repository.
    -->
    <profile>
      <id>publish</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>com.google.cloud.tools</groupId>
              <artifactId>jib-maven-plugin</artifactId>
              <executions>
                <execution>
                  <id>push-image</id>
                  <phase>package</phase>
                  <goals>
                    <goal>build</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
