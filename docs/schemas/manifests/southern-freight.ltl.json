{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Southern Freight part-truckload consignment",
  "description": "Less-than-truckload on the Bengaluru to Chennai lane. The only mode where one vehicle carries several customers' freight at once, so the consignment is priced per piece and the e-way bill is per consignment rather than per truck.",
  "type": "object",
  "required": ["ewayBillNo", "freightClass", "pieces", "billTo"],
  "additionalProperties": false,
  "properties": {
    "ewayBillNo": {
      "type": "string",
      "description": "GST e-way bill, required for goods above Rs 50,000 moving between states",
      "pattern": "^[0-9]{12}$"
    },
    "freightClass": {
      "type": "string",
      "description": "Density-based rate class; higher classes are lighter and bulkier per rupee",
      "enum": ["50", "55", "60", "65", "70", "77.5", "85", "92.5", "100", "125", "150", "175", "200"]
    },
    "pieces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "weightKg"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 3 },
          "weightKg": { "type": "number", "exclusiveMinimum": 0, "maximum": 5000 },
          "dimensionsCm": {
            "type": "object",
            "required": ["length", "width", "height"],
            "additionalProperties": false,
            "properties": {
              "length": { "type": "number", "exclusiveMinimum": 0 },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "hazmat": { "type": "boolean" }
        }
      }
    },
    "billTo": {
      "type": "object",
      "required": ["party", "gstin"],
      "additionalProperties": false,
      "properties": {
        "party": { "type": "string" },
        "gstin": {
          "type": "string",
          "description": "15-character GST identification number",
          "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][0-9A-Z]{3}$"
        }
      }
    },
    "accessorials": {
      "type": "array",
      "description": "Extra services charged on top of the line haul",
      "items": {
        "type": "string",
        "enum": ["LIFTGATE", "INSIDE_DELIVERY", "APPOINTMENT", "RESIDENTIAL", "REWEIGH"]
      },
      "uniqueItems": true
    }
  }
}
