<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.fleettracking</groupId>
    <artifactId>fleet-tracking-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>fleet-simulator</artifactId>
  <name>fleet-simulator</name>
  <description>Synthetic fleet: drives trucks along routes and emits the four source formats</description>

  <dependencies>
    <!-- GeoPoint and, from S5, the source envelopes this simulator's output normalizes into. -->
    <dependency>
      <groupId>com.fleettracking</groupId>
      <artifactId>events</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Plain starter, not starter-web: nothing here serves HTTP yet. An endpoint to steer the
         simulation arrives in S5 when there are faults worth switching on at runtime. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- @ConfigurationProperties binding plus the IDE metadata for it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The repackage goal has to be declared, not just the plugin. Projects that inherit
           spring-boot-starter-parent get this execution for free; this build imports the BOM
           instead (so libs/events stays a plain library), which brings the dependency versions
           but none of the parent's plugin executions. Without it the jar builds fine and then
           fails at runtime with "no main manifest attribute". -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
