<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.fleettracking</groupId>
    <artifactId>fleet-tracking-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>events</artifactId>
  <name>events</name>
  <description>Canonical event model shared by every service</description>

  <dependencies>
    <!-- Jackson 3 (group tools.jackson), which is what Spring Boot 4 auto-configures.
         Jackson 2 (com.fasterxml.jackson) is also managed by the BOM as a compatibility
         path, but a model annotated for 2 would be ignored by the services' mapper.
         java.time support is built into databind 3 - no jackson-datatype-jsr310. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Constraints are declared here; the implementation is the caller's choice.
         Services get Hibernate Validator from spring-boot-starter-validation. -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>

    <!-- Test-scope only: needed to actually run the constraints in this module's tests. -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
