# --- Java / Maven ---
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml
.mvn/.gradle-enterprise/
.mvn/.develocity/

# --- Node / dashboard ---
node_modules/
dist/
.vite/
*.local

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
# .terraform.lock.hcl is committed, deliberately: it pins provider versions and checksums the way
# package-lock.json does, so a second machine or CI cannot resolve a different provider.

# --- Secrets / local config ---
.env
.env.*
!.env.example
*.pem
*.key
kubeconfig
atlas-connection-string.txt

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.classpath
.project

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Build / test output ---
*.log
logs/
surefire-reports/
failsafe-reports/

# --- Local demo run state (scripts/demo.sh: pids and service logs) ---
.demo/

# --- Downloaded CLI tools (fetched by scripts/kafka-cli.sh, never committed) ---
.tools/

# --- Local-only working notes (deliberately not published) ---
CLAUDE.md
LEARNING.md
