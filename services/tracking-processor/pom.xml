<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.fleettracking</groupId>
    <artifactId>fleet-tracking-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>tracking-processor</artifactId>
  <name>tracking-processor</name>
  <description>Consumes position events and keeps shipment position history and current position</description>

  <dependencies>
    <!-- The canonical envelopes this service consumes, and the topic names it reads. -->
    <dependency>
      <groupId>com.fleettracking</groupId>
      <artifactId>events</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The itinerary read model and the haversine both consumers need. It moved out of this
         service in S13, when the exception service needed the same scheduled stops: two copies of
         a reference-data mapping drift in exactly the way two copies of a topic name do. -->
    <dependency>
      <groupId>com.fleettracking</groupId>
      <artifactId>reference</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- starter-web, and only for the sake of the probes below. Nothing calls this service : it
         pulls its work from a topic, and it did without a servlet container at all until S17. What
         changed is that Kubernetes has to be able to ask a container whether it is alive and
         whether it is ready, and the only answer available to a process with no port is an exec
         probe, which can tell that a JVM exists and nothing whatever about whether it is still
         consuming. The HTTP surface here is the actuator endpoints and nothing else : there is not
         a single controller in this module. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>

    <!-- Health, liveness and readiness over HTTP. Kubernetes decides whether to restart a
         container and whether to send it traffic by asking it, and an answer of "the process
         exists" is not the same answer as "the application works". Actuator supplies both, as
         two separate endpoints with two separate meanings. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Artifact ids carry the Testcontainers 2.x "testcontainers-" prefix; the 1.x coordinates
         are unmanaged by the Boot BOM and fail with "version is missing". -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mongodb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The repackage goal is declared explicitly because this build imports the Spring Boot
           BOM rather than inheriting spring-boot-starter-parent: it gets versions but none of the
           parent's plugin executions, and without this the jar builds silently and then dies with
           "no main manifest attribute". -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Container image. All configuration is in the parent's pluginManagement so that five
           service images cannot drift apart; this module only opts in. -->
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
