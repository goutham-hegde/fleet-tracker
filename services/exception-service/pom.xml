<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.fleettracking</groupId>
    <artifactId>fleet-tracking-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>exception-service</artifactId>
  <name>exception-service</name>
  <description>Watches the streams for SLA breaches, and raises and clears them</description>

  <dependencies>
    <!-- The envelopes on the three topics this reads, and the exception pair it writes. -->
    <dependency>
      <groupId>com.fleettracking</groupId>
      <artifactId>events</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The scheduled stops, which two of the five rules need: one to know whether a
         stationary truck is somewhere it is meant to be, the other to know how far a
         position has strayed from the planned corridor. -->
    <dependency>
      <groupId>com.fleettracking</groupId>
      <artifactId>reference</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- starter-web, and only so that the actuator probes have somewhere to answer : nothing
         calls this service, and there is no controller in the module. Same reasoning as the
         tracking processor, which made the same change in S17 for the same reason. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>

    <!-- Health, liveness and readiness over HTTP. Kubernetes decides whether to restart a
         container and whether to send it traffic by asking it, and an answer of "the process
         exists" is not the same answer as "the application works". Actuator supplies both, as
         two separate endpoints with two separate meanings. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mongodb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Declared explicitly because this build imports the Spring Boot BOM rather than
           inheriting the starter parent: without the repackage goal the jar builds with no
           warning and dies at runtime with "no main manifest attribute". -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Container image. All configuration is in the parent's pluginManagement so that five
           service images cannot drift apart; this module only opts in. -->
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
