<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.fleettracking</groupId>
    <artifactId>fleet-tracking-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>dashboard-api</artifactId>
  <name>dashboard-api</name>
  <description>Read-only query API and live event stream for the map dashboard</description>

  <dependencies>
    <!-- The envelopes on the three topics this reads. Nothing here produces an event: this
         module depends on the event model purely to parse what other services published. -->
    <dependency>
      <groupId>com.fleettracking</groupId>
      <artifactId>events</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The scheduled stops, and the haversine. Both are needed to answer "how far is this
         truck from its next stop" freshly on every request rather than reading a distance
         that was written when an estimate was last published. -->
    <dependency>
      <groupId>com.fleettracking</groupId>
      <artifactId>reference</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>

    <!-- Three listeners, one per topic. This service produces to no topic at all - the only
         service in the platform with a Kafka dependency and no producer. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers 2.x coordinates carry the "testcontainers-" prefix; the 1.x names are
         unmanaged by the Boot BOM and fail with "version is missing". -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mongodb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Declared explicitly because this build imports the Spring Boot BOM rather than
           inheriting the starter parent: without the repackage goal the jar builds with no
           warning and dies at runtime with "no main manifest attribute". -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
